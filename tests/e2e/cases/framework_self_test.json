{
  "id": "framework-self-test",
  "name": "测试框架离线自检",
  "tags": ["framework", "offline"],
  "variables": {
    "ready": true
  },
  "steps": [
    {
      "type": "assert",
      "from": "vars",
      "path": "ready",
      "equals": true
    },
    {
      "type": "set",
