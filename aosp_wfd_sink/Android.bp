// WFD sink JNI prebuilt.
// The Java/AIDL sources are integrated into the canonical framework and services
// source globs; this module owns the single JNI library source for both ABIs.
cc_prebuilt_library_shared {
    name: "libwfdsink_jni_hsvj",
    arch: {
        arm: {
            srcs: ["prebuilts/armeabi-v7a/libwfdsink_jni_hsvj.so"],
        },
        arm64: {
            srcs: ["prebuilts/arm64-v8a/libwfdsink_jni_hsvj.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
    strip: {
        none: true,
    },
}
