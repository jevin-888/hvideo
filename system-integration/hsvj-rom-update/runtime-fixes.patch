diff --git a/vendor/chuangwei-minimal-perf/hsvj_perf_tune.sh b/vendor/chuangwei-minimal-perf/hsvj_perf_tune.sh
--- a/vendor/chuangwei-minimal-perf/hsvj_perf_tune.sh
+++ b/vendor/chuangwei-minimal-perf/hsvj_perf_tune.sh
@@ -126,12 +126,13 @@
 logi "start mode=$MODE lock_max=$LOCK_MAX"
 
 if [ -d /huoshan ]; then
-    chown -R system:system /huoshan 2>/dev/null
-    chmod 0777 /huoshan 2>/dev/null
-    find /huoshan -type d -exec chmod 0777 {} + 2>/dev/null
-    find /huoshan -type f -exec chmod 0666 {} + 2>/dev/null
-    restorecon -RF /huoshan 2>/dev/null
-    logi "fixed /huoshan permissions"
+    # The signed ROM transaction belongs to root, including across reboots.
+    # Do not follow links or recursively relabel the protected staging tree.
+    find /huoshan -path /huoshan/.rom-update -prune -o -type d \
+        -exec chown system:system {} + -exec chmod 0777 {} + -exec restorecon -F {} + 2>/dev/null
+    find /huoshan -path /huoshan/.rom-update -prune -o -type f \
+        -exec chown system:system {} + -exec chmod 0666 {} + -exec restorecon -F {} + 2>/dev/null
+    logi "fixed /huoshan permissions; protected ROM staging excluded"
 fi
 
 setprop service.adb.tcp.port 5555
diff --git a/vendor/chuangwei-minimal-perf/chuangwei_minimal_perf.mk b/vendor/chuangwei-minimal-perf/chuangwei_minimal_perf.mk
