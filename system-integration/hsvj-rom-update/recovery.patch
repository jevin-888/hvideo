diff --git a/bootable/recovery/recovery_main.cpp b/bootable/recovery/recovery_main.cpp
index e6852c7393..e6cad453f1 100644
--- a/bootable/recovery/recovery_main.cpp
+++ b/bootable/recovery/recovery_main.cpp
@@ -27,6 +27,7 @@
 #include <string.h>
 #include <sys/stat.h>
 #include <sys/types.h>
+#include <sys/wait.h>
 #include <time.h>
 #include <unistd.h>
 
@@ -522,6 +523,48 @@ int main(int argc, char** argv) {
 
   SetLoggingSehandle(sehandle);
 
+  // Internal updates initialize the normal UI but never enter legacy RK
+  // installation, media probing, or automatic format fallbacks.
+  for (const auto& argument : args) {
+    const std::string prefix = "--hsvj_update=";
+    if (argument.compare(0, prefix.size(), prefix) != 0) continue;
+    std::string id = argument.substr(prefix.size());
+    ui->SetBackground(RecoveryUI::INSTALLING_UPDATE);
+    ui->ShowText(true);
+    ui->Print("HSVJ ROM update. Do not power off.\n");
+    if (IsRoDebuggable() || IsDeviceUnlocked()) SetUsbConfig("adb");
+    int pipes[2];
+    pid_t child = -1;
+    if (pipe(pipes) == 0) {
+      child = fork();
+      if (child == 0) {
+        close(pipes[0]);
+        dup2(pipes[1], STDOUT_FILENO);
+        dup2(pipes[1], STDERR_FILENO);
+        close(pipes[1]);
+        execl("/system/bin/hsvj-rom-update", "hsvj-rom-update", "--recover", id.c_str(), nullptr);
+        _exit(127);
+      }
+      close(pipes[1]);
+      FILE* output = fdopen(pipes[0], "r");
+      if (output) {
+        char line[1024];
+        while (fgets(line, sizeof(line), output)) ui->Print("%s", line);
+        fclose(output);
+      } else { close(pipes[0]); }
+    }
+    int result = -1;
+    if (child > 0) while (waitpid(child, &result, 0) < 0 && errno == EINTR) {}
+    if (result == 0) {
+      ui->Print("ROM verified. Rebooting...\n");
+    } else {
+      ui->SetBackground(RecoveryUI::ERROR);
+      ui->Print("Installer returned %d. Waiting for service; no automatic retry.\n", result);
+    }
+    // A successful helper requests reboot. A failure must never run vendor fallback.
+    for (;;) pause();
+  }
+
   std::atomic<Device::BuiltinAction> action;
   std::thread listener_thread(ListenRecoverySocket, ui, std::ref(action));
   listener_thread.detach();
